{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Digital Library",
  "version": "0.1.0",
  "identifier": "dev.digitallibrary.app",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Digital Library",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' blob:",
        "img-src": "'self' data: blob: cover: http://cover.localhost catalog-cover: http://catalog-cover.localhost",
        "font-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost book: http://book.localhost",
        "worker-src": "'self' blob:",
        "frame-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A beautiful home for your ebooks and PDFs",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
